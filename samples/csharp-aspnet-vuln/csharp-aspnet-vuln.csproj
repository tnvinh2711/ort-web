<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- CVE-2024-21907 — Newtonsoft.Json ReDoS via crafted JSON -->
    <PackageReference Include="Newtonsoft.Json" Version="10.0.1" />

    <!-- CVE-2018-8292 — System.Net.Http leaks auth on redirect -->
    <PackageReference Include="System.Net.Http" Version="4.3.0" />

    <!-- CVE-2021-26701 — System.Text.Encodings.Web RCE via crafted input (CVSS 9.8) -->
    <PackageReference Include="System.Text.Encodings.Web" Version="4.5.0" />

    <!-- CVE-2022-34716 — System.Security.Cryptography.Pkcs info disclosure -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="6.0.0" />

    <!-- CVE-2022-38013 — Microsoft.AspNetCore.App DoS via malformed multipart -->
    <PackageReference Include="Microsoft.AspNetCore.Http" Version="2.1.22" />

    <!-- CVE-2021-34532 — ASP.NET Core logs JWT signing keys in plaintext -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="5.0.7" />

    <!-- CVE-2023-29331, CVE-2023-33170 — ASP.NET identity auth bypass -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="5.0.7" />

    <!-- CVE-2022-41032 — NuGet client RCE via crafted package -->
    <PackageReference Include="NuGet.Commands" Version="5.9.0" />

    <!-- CVE-2022-30184 — dotnet info disclosure via HTTP header -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="5.0.7" />
  </ItemGroup>

</Project>
